{
  "name": "IncomeStream",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the income stream (e.g. Salary, Freelance, Overtime)"
    },
    "amount": {
      "type": "number",
      "description": "Amount per occurrence. For salary (before-tax) mode this is 0; take-home is derived from tax_settings."
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "fortnightly",
        "four_weekly",
        "monthly",
        "quarterly",
        "annually",
        "irregular"
      ],
      "description": "How often this income is received / the pay schedule"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Anchor date (YYYY-MM-DD). For the primary stream this is the first known payday."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Optional end date \u2014 income stops after this date (YYYY-MM-DD)"
    },
    "next_payment_date": {
      "type": "string",
      "format": "date",
      "description": "Next expected payment date (YYYY-MM-DD). Required for irregular income; informational for regular income."
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "True for the user's main income stream, which holds the pay schedule and tax settings."
    },
    "income_type": {
      "type": "string",
      "enum": [
        "salary",
        "overtime",
        "second_job",
        "freelance",
        "benefits",
        "pension",
        "bonus",
        "other"
      ],
      "default": "other",
      "description": "Type of income source"
    },
    "is_variable": {
      "type": "boolean",
      "default": false,
      "description": "True if the amount varies from period to period (estimated amount)"
    },
    "variable_forecast_percent": {
      "type": "number",
      "description": "Optional conservative forecast percentage (0-100). When set, expected (non-confirmed) variable amounts are forecast at this percentage of their expected value."
    },
    "variable_periods": {
      "type": "array",
      "description": "Per-period overrides for variable income. Each entry sets expected/confirmed/actual amounts for a specific pay period date.",
      "items": {
        "type": "object",
        "properties": {
          "period_date": {
            "type": "string",
            "format": "date",
            "description": "The pay period date this override applies to (YYYY-MM-DD)"
          },
          "expected_amount": {
            "type": "number",
            "description": "Expected amount for this period"
          },
          "confirmed_amount": {
            "type": "number",
            "description": "Confirmed amount (once known). Used at full value in forecasts."
          },
          "actual_amount": {
            "type": "number",
            "description": "Actual amount received (manually entered). Used at full value when present."
          }
        }
      }
    },
    "scheduled_changes": {
      "type": "array",
      "description": "Future-dated income changes: pay rises/reductions (amount), one-off payments (one_off, e.g. bonuses), or temporary additions (addition, e.g. overtime).",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique id for this change entry"
          },
          "label": {
            "type": "string",
            "description": "Optional label e.g. 'Pay rise', 'Christmas bonus'"
          },
          "change_type": {
            "type": "string",
            "enum": [
              "amount",
              "one_off",
              "addition"
            ],
            "description": "amount = new per-occurrence amount from effective_date; one_off = single payment on effective_date; addition = extra amount added per occurrence from effective_date to end_date"
          },
          "amount": {
            "type": "number",
            "description": "For amount/addition: the new or extra per-occurrence amount. For one_off: the payment amount."
          },
          "gross_annual": {
            "type": "number",
            "description": "For salary-mode 'amount' changes: the new gross annual salary (take-home is recomputed)."
          },
          "effective_date": {
            "type": "string",
            "format": "date",
            "description": "When the change takes effect (YYYY-MM-DD)"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Optional end date (YYYY-MM-DD). For 'amount' changes the base resumes after this; for 'addition' the extra stops after this."
          }
        }
      }
    },
    "pay_day": {
      "type": "number",
      "description": "Day of month for monthly pay (1-31). Primary stream only."
    },
    "pay_weekday": {
      "type": "string",
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday",
        "last_working_day",
        "none"
      ],
      "default": "none",
      "description": "Weekday rule for weekly/fortnightly/four_weekly pay, or last_working_day for monthly. Primary stream only."
    },
    "income_mode": {
      "type": "string",
      "enum": [
        "net",
        "salary"
      ],
      "default": "net",
      "description": "net = take-home amount per cycle; salary = gross before tax, with UK tax applied via tax_settings."
    },
    "tax_settings": {
      "type": "object",
      "description": "UK tax configuration for salary (before-tax) mode.",
      "properties": {
        "grossAnnual": {
          "type": "number",
          "description": "Gross annual salary"
        },
        "taxCode": {
          "type": "string",
          "description": "UK tax code (e.g. 1257L)"
        },
        "studentLoanPlan": {
          "type": "string"
        },
        "pensionType": {
          "type": "string"
        },
        "pensionValue": {
          "type": "number"
        },
        "pensionIsSalarySacrifice": {
          "type": "boolean"
        },
        "salarySacrificeMonthly": {
          "type": "number"
        },
        "otherDeductionsMonthly": {
          "type": "number"
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "name",
    "amount",
    "frequency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}