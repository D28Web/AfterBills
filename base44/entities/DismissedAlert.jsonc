{
  "name": "DismissedAlert",
  "type": "object",
  "properties": {
    "alert_key": {
      "type": "string",
      "description": "Stable key identifying the dismissed automatic alert (matches the key produced by the alerts engine)"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Optional expiry date. When set and in the past, the alert resurfaces. Null or absent means a permanent dismissal."
    }
  },
  "required": [
    "alert_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}