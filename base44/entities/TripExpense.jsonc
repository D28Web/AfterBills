{
  "name": "TripExpense",
  "type": "object",
  "properties": {
    "trip_name": {
      "type": "string",
      "description": "Name of the trip this expense belongs to"
    },
    "description": {
      "type": "string",
      "description": "What the expense is for (e.g. Flights, Hotel, Food)"
    },
    "amount": {
      "type": "number",
      "description": "Total cost of the expense (full price before any split)"
    },
    "is_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether this expense has been paid"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "When this expense needs to be paid by (YYYY-MM-DD)"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "When this expense was actually paid (YYYY-MM-DD)"
    },
    "category": {
      "type": "string",
      "enum": [
        "travel",
        "accommodation",
        "food",
        "activities",
        "transport",
        "shopping",
        "other"
      ],
      "default": "other",
      "description": "Expense category"
    },
    "is_split": {
      "type": "boolean",
      "default": false,
      "description": "Whether this expense is split between multiple people"
    },
    "split_between": {
      "type": "number",
      "default": 2,
      "description": "Number of people the expense is split between (your share = amount / split_between)"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "trip_name",
    "description",
    "amount",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}