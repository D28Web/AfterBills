{
  "name": "SavingsGoal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the savings goal"
    },
    "target_amount": {
      "type": "number",
      "description": "Target amount to save"
    },
    "current_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount saved so far"
    },
    "icon": {
      "type": "string",
      "description": "Icon identifier for the goal"
    },
    "is_emergency_fund": {
      "type": "boolean",
      "default": false,
      "description": "True if this is an emergency fund goal (target based on essential expenses)"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "fixed",
        "months"
      ],
      "default": "fixed",
      "description": "fixed = a set target amount; months = target expressed as N months of essential expenses"
    },
    "target_months": {
      "type": "number",
      "description": "For target_type 'months': number of months of essential expenses to cover"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "attachments": {
      "type": "array",
      "description": "Optional supporting documents (policy documents, quotes, supporting records). Files are stored privately and accessible only to the owner.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Filename"
          },
          "file_uri": {
            "type": "string",
            "description": "Private storage URI"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date",
            "description": "When the file was uploaded (YYYY-MM-DD)"
          }
        },
        "required": [
          "name",
          "file_uri"
        ]
      }
    }
  },
  "required": [
    "name",
    "target_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}