{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "owner"
      ],
      "default": "user"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active",
      "description": "Whether the account is active or disabled by an administrator"
    },
    "currency": {
      "type": "string",
      "default": "\u00a3",
      "description": "Currency symbol"
    }
  },
  "required": []
}