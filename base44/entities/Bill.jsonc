{
  "name": "Bill",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the bill"
    },
    "amount": {
      "type": "number",
      "description": "Total bill amount (full price before any split). For loans/credit cards this is the payment made each period."
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "The date the bill first started / is anchored to (YYYY-MM-DD). The day-of-month is used as the due day each period."
    },
    "category": {
      "type": "string",
      "enum": [
        "housing",
        "utilities",
        "insurance",
        "transport",
        "subscriptions",
        "loans",
        "credit_cards",
        "food",
        "health",
        "education",
        "other"
      ],
      "description": "Bill category"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "fortnightly",
        "four_weekly",
        "monthly",
        "quarterly",
        "annually"
      ],
      "description": "How often the bill occurs"
    },
    "is_recurring": {
      "type": "boolean",
      "default": true,
      "description": "Whether the bill recurs"
    },
    "essential": {
      "type": "boolean",
      "description": "Whether this bill is an essential expense (true) or non-essential (false). Null means unclassified \u2014 the category-based default is used until the user sets it. Used in affordability and emergency fund calculations."
    },
    "target_end_date": {
      "type": "string",
      "format": "date",
      "description": "Targeted payoff date for loans / credit cards (YYYY-MM-DD). Optional."
    },
    "remaining_balance": {
      "type": "number",
      "description": "Outstanding balance still owed on a loan / credit card. Optional."
    },
    "is_split": {
      "type": "boolean",
      "default": false,
      "description": "Whether this bill is split between multiple people"
    },
    "split_between": {
      "type": "number",
      "default": 2,
      "description": "Number of people the bill is split between (your share = amount / split_between)"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date",
      "description": "Contract start date (YYYY-MM-DD). Optional."
    },
    "contract_end_date": {
      "type": "string",
      "format": "date",
      "description": "Contract end date (YYYY-MM-DD). Optional."
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Next renewal date for the contract (YYYY-MM-DD). Optional."
    },
    "notice_period_days": {
      "type": "number",
      "description": "Notice period in days required to cancel before renewal. Optional."
    },
    "intro_price_end_date": {
      "type": "string",
      "format": "date",
      "description": "When the introductory price ends (YYYY-MM-DD). Optional."
    },
    "expected_new_price": {
      "type": "number",
      "description": "Expected price after the introductory period ends. The bill amount is NOT changed automatically \u2014 the user must confirm. Optional."
    },
    "amount_history": {
      "type": "array",
      "description": "History of amount changes for this bill. Each entry records the previous and new amount, effective date, and percentage change.",
      "items": {
        "type": "object",
        "properties": {
          "previous_amount": {
            "type": "number",
            "description": "Amount before the change"
          },
          "new_amount": {
            "type": "number",
            "description": "Amount after the change"
          },
          "effective_date": {
            "type": "string",
            "format": "date",
            "description": "When the new amount took effect (YYYY-MM-DD)"
          },
          "percentage_change": {
            "type": "number",
            "description": "Percentage change from previous to new amount"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "name",
    "amount",
    "start_date",
    "category",
    "frequency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}