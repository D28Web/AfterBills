{
  "name": "Bill",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the bill"
    },
    "amount": {
      "type": "number",
      "description": "Bill amount"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "The date the bill first started / is anchored to (YYYY-MM-DD). The day-of-month is used as the due day each period."
    },
    "category": {
      "type": "string",
      "enum": [
        "housing",
        "utilities",
        "insurance",
        "transport",
        "subscriptions",
        "loans",
        "food",
        "health",
        "education",
        "other"
      ],
      "description": "Bill category"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "fortnightly",
        "monthly",
        "quarterly",
        "annually"
      ],
      "description": "How often the bill occurs"
    },
    "is_recurring": {
      "type": "boolean",
      "default": true,
      "description": "Whether the bill recurs"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "name",
    "amount",
    "start_date",
    "category",
    "frequency"
  ]
}