{
  "name": "Bill",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the bill"
    },
    "amount": {
      "type": "number",
      "description": "Total bill amount (full price before any split). For loans/credit cards this is the payment made each period."
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "The date the bill first started / is anchored to (YYYY-MM-DD). The day-of-month is used as the due day each period. For financed commitments, this is the agreement start date."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Optional end date (YYYY-MM-DD). When set, the bill stops being included in forecasts after this date (temporary bills)."
    },
    "category": {
      "type": "string",
      "enum": [
        "housing",
        "utilities",
        "insurance",
        "transport",
        "subscriptions",
        "loans",
        "credit_cards",
        "food",
        "health",
        "education",
        "other"
      ],
      "description": "Bill category"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "fortnightly",
        "four_weekly",
        "monthly",
        "quarterly",
        "annually"
      ],
      "description": "How often the bill occurs"
    },
    "is_recurring": {
      "type": "boolean",
      "default": true,
      "description": "Whether the bill recurs"
    },
    "essential": {
      "type": "boolean",
      "description": "Whether this bill is an essential expense (true) or non-essential (false). Null means unclassified \u2014 the category-based default is used until the user sets it. Used in affordability and emergency fund calculations."
    },
    "is_salary_sacrifice": {
      "type": "boolean",
      "default": false,
      "description": "Whether this bill is a salary sacrifice deduction (pre-tax). Salary sacrifice items are shown separately and NOT deducted again from take-home income \u2014 in salary (gross) mode they are already in the tax calculation; in net mode they are already deducted by the employer."
    },
    "bill_assignment": {
      "type": "string",
      "enum": [
        "personal",
        "shared"
      ],
      "default": "personal",
      "description": "Whether this bill is a personal bill or a shared household bill. Shared bills are counted once in household totals."
    },
    "household_member_id": {
      "type": "string",
      "description": "ID of the household member this bill belongs to (optional, for household support)"
    },
    "finance_type": {
      "type": "string",
      "enum": [
        "mortgage",
        "personal_loan",
        "hp",
        "pcp",
        "car_loan",
        "student_loan",
        "credit_agreement",
        "other_finance"
      ],
      "description": "When set, this bill is a financed commitment (mortgage, loan, car finance, etc.) and finance-specific tracking fields apply. Null/absent means a normal recurring bill."
    },
    "interest_rate": {
      "type": "number",
      "description": "Annual interest rate as a percentage (e.g. 5.5 for 5.5%). Optional."
    },
    "interest_type": {
      "type": "string",
      "enum": [
        "fixed",
        "tracker",
        "variable",
        "discount",
        "other"
      ],
      "description": "Interest rate type. Primarily for mortgages and student loans."
    },
    "apr": {
      "type": "number",
      "description": "Annual Percentage Rate (APR) as a percentage, where it differs from the interest rate. Optional."
    },
    "original_term_months": {
      "type": "number",
      "description": "Original agreement term in months. Optional."
    },
    "remaining_term_months": {
      "type": "number",
      "description": "Remaining term in months. Optional \u2014 can be derived from agreement end date or original term if not provided."
    },
    "agreement_end_date": {
      "type": "string",
      "format": "date",
      "description": "Agreement end date (YYYY-MM-DD). The scheduled end of the finance agreement, distinct from a target payoff goal."
    },
    "balloon_payment": {
      "type": "number",
      "description": "Final / balloon payment due at the end of the agreement (e.g. PCP). Optional."
    },
    "overpayment_amount": {
      "type": "number",
      "description": "Regular overpayment amount. Optional."
    },
    "overpayment_frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "fortnightly",
        "four_weekly",
        "monthly",
        "quarterly",
        "annually"
      ],
      "description": "How often the overpayment is made."
    },
    "early_repayment_charge": {
      "type": "number",
      "description": "Early repayment charge amount (fixed) or percentage (if early_repayment_charge_type is 'percentage'). Optional."
    },
    "early_repayment_charge_type": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage"
      ],
      "description": "Whether the early repayment charge is a fixed amount or a percentage of the remaining balance."
    },
    "property_value": {
      "type": "number",
      "description": "Estimated property value, for mortgages. Used to calculate loan-to-value (LTV). Optional."
    },
    "fixed_rate_end_date": {
      "type": "string",
      "format": "date",
      "description": "When the fixed-rate period ends (YYYY-MM-DD). For fixed-rate mortgages. Optional."
    },
    "scheduled_changes": {
      "type": "array",
      "description": "Future-dated amount changes for this bill (e.g. rent increase, renewal price). Each change overrides the base amount from its effective date until its optional end date. Historical amounts are preserved in amount_history.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique id for this change entry"
          },
          "label": {
            "type": "string",
            "description": "Optional label e.g. 'Rent increase'"
          },
          "amount": {
            "type": "number",
            "description": "New total amount (full price) for this period"
          },
          "effective_date": {
            "type": "string",
            "format": "date",
            "description": "When the new amount takes effect (YYYY-MM-DD)"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Optional end date (YYYY-MM-DD). When set, the base amount resumes after this date."
          }
        }
      }
    },
    "target_end_date": {
      "type": "string",
      "format": "date",
      "description": "Targeted payoff date for loans / credit cards (YYYY-MM-DD). Optional."
    },
    "remaining_balance": {
      "type": "number",
      "description": "Outstanding balance still owed on a loan / credit card / financed commitment. Optional."
    },
    "original_balance": {
      "type": "number",
      "description": "Original balance when the loan / credit card / finance agreement was taken out. Optional. Used with remaining_balance to recognise debt-repaid milestones (25%, 50%, 75%, cleared)."
    },
    "is_split": {
      "type": "boolean",
      "default": false,
      "description": "Whether this bill is split between multiple people"
    },
    "split_between": {
      "type": "number",
      "default": 2,
      "description": "Number of people the bill is split between (your share = amount / split_between)"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date",
      "description": "Contract start date (YYYY-MM-DD). Optional."
    },
    "contract_end_date": {
      "type": "string",
      "format": "date",
      "description": "Contract end date (YYYY-MM-DD). Optional."
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Next renewal date for the contract (YYYY-MM-DD). Optional."
    },
    "notice_period_days": {
      "type": "number",
      "description": "Notice period in days required to cancel before renewal. Optional."
    },
    "intro_price_end_date": {
      "type": "string",
      "format": "date",
      "description": "When the introductory price ends (YYYY-MM-DD). Optional."
    },
    "expected_new_price": {
      "type": "number",
      "description": "Expected price after the introductory period ends. The bill amount is NOT changed automatically \u2014 the user must confirm. Optional."
    },
    "amount_history": {
      "type": "array",
      "description": "History of amount changes for this bill. Each entry records the previous and new amount, effective date, and percentage change. Individual entries can be deleted if entered incorrectly.",
      "items": {
        "type": "object",
        "properties": {
          "previous_amount": {
            "type": "number",
            "description": "Amount before the change"
          },
          "new_amount": {
            "type": "number",
            "description": "Amount after the change"
          },
          "effective_date": {
            "type": "string",
            "format": "date",
            "description": "When the new amount took effect (YYYY-MM-DD)"
          },
          "percentage_change": {
            "type": "number",
            "description": "Percentage change from previous to new amount"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "attachments": {
      "type": "array",
      "description": "Optional supporting documents (renewal documents, policy documents, quotes, contracts, supporting records). Files are stored privately and accessible only to the owner.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Filename"
          },
          "file_uri": {
            "type": "string",
            "description": "Private storage URI"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date",
            "description": "When the file was uploaded (YYYY-MM-DD)"
          }
        },
        "required": [
          "name",
          "file_uri"
        ]
      }
    }
  },
  "required": [
    "name",
    "amount",
    "start_date",
    "category",
    "frequency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}